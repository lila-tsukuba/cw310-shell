proc add_mig_instance { } {
	set mig_7series_1 [ create_bd_cell -type ip -vlnv xilinx.com:ip:mig_7series:4.2 mig_7series_1 ]

	# Generate the PRJ File for MIG
	set str_mig_folder [get_property IP_DIR [ get_ips [ get_property CONFIG.Component_Name $mig_7series_1 ] ] ]
	set str_mig_file_name mig_a.prj
	set str_mig_file_path ${str_mig_folder}/${str_mig_file_name}
	write_mig_file_main_mig_7series_1_0 $str_mig_file_path

	set_property -dict [list \
		CONFIG.BOARD_MIG_PARAM {Custom} \
		CONFIG.MIG_DONT_TOUCH_PARAM {Custom} \
		CONFIG.RESET_BOARD_INTERFACE {Custom} \
		CONFIG.XML_INPUT_FILE {mig_a.prj} \
	] $mig_7series_1

	# Create instance: rst_mig_7series_1, and set properties
	set rst_mig_7series_1 [ create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 rst_mig_7series_1 ]

	# Create instance: tie_high, and set properties
	set tie_high [ create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 tie_high ]
	set_property -dict [list \
		CONFIG.CONST_VAL {1} \
		CONFIG.CONST_WIDTH {1} \
	] $tie_high

	# create MIG related ports
	set OSC [ create_bd_intf_port -mode Slave -vlnv xilinx.com:interface:diff_clock_rtl:1.0 OSC ]
	set DDR3 [ create_bd_intf_port -mode Master -vlnv xilinx.com:interface:ddrx_rtl:1.0 DDR3 ]
	set OSC_EN [ create_bd_port -dir O -from 0 -to 0 OSC_EN ]
	set VDDR_ENABLE [ create_bd_port -dir O -from 0 -to 0 VDDR_ENABLE ]

	# create interconnection regading the mig_7series_1
	connect_bd_intf_net -intf_net net_osc_clk [get_bd_intf_ports OSC] \
		[get_bd_intf_pins mig_7series_1/SYS_CLK]

	connect_bd_intf_net -intf_net net_usb_interface_0_axi_periph_M01_AXI \
		[get_bd_intf_pins usb_interface_0_axi_periph/M01_AXI] \
		[get_bd_intf_pins mig_7series_1/S_AXI]

	connect_bd_intf_net -intf_net net_mig_7series_1_DDR3 \
		[get_bd_intf_ports DDR3] \
		[get_bd_intf_pins mig_7series_1/DDR3]

	connect_bd_net -net net_rst_sys_clk_peripheral_aresetn \
		[get_bd_pins mig_7series_1/sys_rst]

	connect_bd_net -net net_mig_7series_1_mmcm_locked \
		[get_bd_pins mig_7series_1/mmcm_locked] \
		[get_bd_pins rst_mig_7series_1/dcm_locked]

	connect_bd_net -net net_mig_7series_1_ui_clk \
		[get_bd_pins mig_7series_1/ui_clk] \
		[get_bd_pins rst_mig_7series_1/slowest_sync_clk] \
		[get_bd_pins usb_interface_0_axi_periph/M01_ACLK]

	connect_bd_net -net net_mig_7series_1_ui_clk_sync_rst \
		[get_bd_pins mig_7series_1/ui_clk_sync_rst] \
		[get_bd_pins rst_mig_7series_1/ext_reset_in]

	connect_bd_net -net net_rst_mig_7series_1_interconnect_aresetn \
		[get_bd_pins rst_mig_7series_1/interconnect_aresetn] \
		[get_bd_pins mig_7series_1/aresetn]

	connect_bd_net -net net_rst_mig_7series_1_peripheral_aresetn \
		[get_bd_pins rst_mig_7series_1/peripheral_aresetn] \
		[get_bd_pins usb_interface_0_axi_periph/M01_ARESETN]

	# always enable the OSC_EN and VDDR_ENABLE signals
	connect_bd_net -net net_mig_enable_signals \
		[get_bd_ports OSC_EN] \
		[get_bd_ports VDDR_ENABLE] \
		[get_bd_pins tie_high/dout]

	# assign address range 128 MB
	assign_bd_address -offset 0x80000000 -range 0x20000000 -target_address_space \
		[get_bd_addr_spaces usb_interface_0/M00_AXI] \
		[get_bd_addr_segs mig_7series_1/memmap/memaddr] -force

}